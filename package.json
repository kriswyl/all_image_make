{
  "name": "image-relay-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "tauri:dev": "tauri dev",
    "tauri:prepare": "node scripts/prepare-tauri.mjs",
    "tauri:build:exe": "tauri build --no-bundle --ci",
    "tauri:package:portable": "node scripts/package-portable.mjs",
    "tauri:package:source": "node scripts/package-source.mjs",
    "tauri:build": "tauri build",
    "start": "node dist/server/server/index.js",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
