{
  "name": "image-relay-studio",
  "version": "2.3.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev:web:preview": "node scripts/preview-web.mjs",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "tauri:dev": "tauri dev",
    "tauri:prepare": "node scripts/prepare-tauri.mjs",
    "tauri:build:exe": "node scripts/tauri-bundle.mjs --no-bundle --ci",
    "tauri:package:portable": "node scripts/package-portable.mjs",
    "tauri:package:installer": "node scripts/package-installer.mjs",
    "tauri:package:source": "node scripts/package-source.mjs",
    "version:set": "node scripts/set-version.mjs",
    "release:portable": "npm test && npm run tauri:build:exe && npm run tauri:package:portable",
    "release:installer": "npm test && npm run tauri:build && npm run tauri:package:installer",
    "tauri:build": "node scripts/tauri-bundle.mjs",
    "start": "node dist/server/server/index.js",
    "test": "vitest run --config vitest.config.ts",
    "eval:ppt": "tsc -p tsconfig.eval.json && node artifacts/eval-runtime/scripts/evaluate-presentation.js",
    "eval:contract": "tsc -p tsconfig.eval.json && node artifacts/eval-runtime/scripts/evaluate-presentation-contract.js",
    "eval:diversity": "tsc -p tsconfig.eval.json && node artifacts/eval-runtime/scripts/measure-presentation-diversity.js",
    "eval:contract:real": "tsc -p tsconfig.eval.json && node artifacts/eval-runtime/scripts/evaluate-presentation-contract-real.js",
    "eval:local-visual": "tsc -p tsconfig.eval.json && node artifacts/eval-runtime/scripts/verify-presentation-local-visual.js",
    "eval:wps": "tsc -p tsconfig.eval.json && node artifacts/eval-runtime/scripts/verify-local-wps.js",
    "eval:visual": "tsc -p tsconfig.eval.json && node artifacts/eval-runtime/scripts/evaluate-presentation-visual.js",
    "eval:edit": "tsc -p tsconfig.eval.json && node artifacts/eval-runtime/scripts/evaluate-native-edit.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ma-shan-zheng": "^5.3.1",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-shell": "2.3.5",
    "@tauri-apps/plugin-updater": "2.12.0",
    "docx": "^9.15.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.11.2",
    "jimp": "^1.6.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "multer": "^2.2.0",
    "omggif": "^1.0.10",
    "pdfjs-dist": "^6.5.438",
    "pptxgenjs": "^4.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "wpsjs-rpc-sdk-new": "1.1.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@lobehub/icons-static-svg": "^1.95.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^30.1.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
