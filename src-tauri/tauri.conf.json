{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ChatCanvas",
  "version": "2.2.3",
  "identifier": "com.imagerelay.studio",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "node scripts/tauri-dev.mjs",
    "beforeBuildCommand": "node scripts/tauri-build.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "ChatCanvas",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "decorations": false,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:17892; img-src 'self' data: blob: http://127.0.0.1:17892; media-src 'self' blob: http://127.0.0.1:17892; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/node"],
    "resources": ["resources/server/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4MjlBNEZDQjNEQkRGODMKUldTRDM5dXovS1FwT01ndG9NUm5ISmZxOGJMZnZLYnNYVkNFQUVXcWZIOXVmdDA5NGQ5TWFUakkK",
      "endpoints": [
        "https://github.com/kriswyl/all_image_make/releases/download/updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
